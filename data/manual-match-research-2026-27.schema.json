{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Football Time Manual Match Research 2026/27",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "season",
    "dataset_status",
    "scope",
    "timezone",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "const": "manual-match-research-2026-27"
    },
    "season": {
      "const": "2026/27"
    },
    "dataset_status": {
      "enum": [
        "research_intake_empty",
        "research_records_present"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "club_competitions",
        "international_competitions",
        "excluded"
      ],
      "properties": {
        "club_competitions": {
          "const": [
            "PL",
            "PD",
            "BL1",
            "SA",
            "FL1"
          ]
        },
        "international_competitions": {
          "const": [
            "UNL"
          ]
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "timezone": {
      "const": "Asia/Bangkok"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "source_type",
        "checked_at",
        "reuse_rights"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "source_type": {
          "enum": [
            "competition_organiser",
            "federation",
            "licensed_provider",
            "aggregator",
            "search_reference",
            "other"
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "reuse_rights": {
          "enum": [
            "confirmed",
            "pending",
            "prohibited"
          ]
        },
        "permission_basis": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provider_player_id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "canonical_player_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "team_name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "competition_code",
        "season",
        "fixture_ref",
        "match_status",
        "verification_status",
        "sources"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "competition_code": {
          "enum": [
            "PL",
            "PD",
            "BL1",
            "SA",
            "FL1",
            "UNL"
          ]
        },
        "season": {
          "const": "2026/27"
        },
        "fixture_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "home_team",
            "away_team"
          ],
          "properties": {
            "provider_match_id": {
              "type": [
                "string",
                "integer",
                "null"
              ]
            },
            "international_fixture_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "kickoff_utc": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "home_team": {
              "type": "string",
              "minLength": 1
            },
            "away_team": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "match_status": {
          "enum": [
            "SCHEDULED",
            "LIVE",
            "FINISHED",
            "POSTPONED",
            "CANCELLED",
            "SUSPENDED",
            "AWARDED"
          ]
        },
        "score": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "home",
            "away"
          ],
          "properties": {
            "home": {
              "type": "integer",
              "minimum": 0
            },
            "away": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "verification_status": {
          "enum": [
            "verified",
            "needs_review",
            "unverified"
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event_id",
              "type",
              "minute",
              "team",
              "player",
              "source_urls"
            ],
            "properties": {
              "event_id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "goal",
                  "assist",
                  "yellow_card",
                  "red_card",
                  "own_goal",
                  "penalty_goal"
                ]
              },
              "minute": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "team": {
                "type": "string"
              },
              "player": {
                "$ref": "#/$defs/player"
              },
              "related_goal_event_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        },
        "ratings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "player",
              "provider",
              "value",
              "scale_min",
              "scale_max",
              "source_url",
              "checked_at",
              "reuse_rights"
            ],
            "properties": {
              "player": {
                "$ref": "#/$defs/player"
              },
              "provider": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "scale_min": {
                "type": "number"
              },
              "scale_max": {
                "type": "number"
              },
              "source_url": {
                "type": "string",
                "format": "uri"
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              },
              "reuse_rights": {
                "enum": [
                  "confirmed",
                  "pending",
                  "prohibited"
                ]
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
