{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://football-ecosystem.local/schemas/result-v1.schema.json",
  "title": "Football Ecosystem Match Result v1 with immutable revision history",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "match_id",
    "league_id",
    "season_id",
    "home_score",
    "away_score",
    "status",
    "result_revision",
    "updated_at",
    "source",
    "revision_history"
  ],
  "properties": {
    "match_id": {
      "type": "string",
      "pattern": "^FT-M-(FOOTBALLDATA-[A-Za-z0-9_-]+|LOCAL-[A-Za-z0-9-]+)$"
    },
    "home_score": {
      "type": "integer",
      "minimum": 0
    },
    "away_score": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "const": "FINISHED"
    },
    "result_revision": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "correction_reason": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "verified_at"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "revision_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result_revision",
          "home_score",
          "away_score",
          "status",
          "recorded_at",
          "source"
        ],
        "properties": {
          "result_revision": {
            "type": "integer",
            "minimum": 1
          },
          "home_score": {
            "type": "integer",
            "minimum": 0
          },
          "away_score": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "const": "FINISHED"
          },
          "change_type": {
            "enum": [
              "baseline",
              "correction",
              "preserved"
            ]
          },
          "reason": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "verified_at"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "verified_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "league_id": {
      "type": "string",
      "enum": [
        "PL",
        "PD",
        "BL1",
        "SA",
        "FL1"
      ]
    },
    "season_id": {
      "const": "2026-2027"
    }
  }
}
