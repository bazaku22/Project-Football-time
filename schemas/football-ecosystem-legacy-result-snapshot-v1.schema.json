{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://football-ecosystem.local/schemas/legacy-result-snapshot-v1.schema.json",
  "title": "Football Time Legacy Match Result Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "export_id", "exported_by", "exported_at", "data_type", "snapshot_policy", "scope", "records"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "export_id": { "type": "string", "minLength": 1 },
    "exported_by": { "const": "football-time" },
    "exported_at": { "type": "string", "format": "date-time" },
    "data_type": { "const": "legacy_match_result_snapshots" },
    "snapshot_policy": { "const": "non_revision_legacy" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["league_ids", "season_ids"],
      "properties": {
        "league_ids": { "type": "array", "items": { "enum": ["PL", "PD", "BL1", "SA", "FL1"] }, "minItems": 5, "maxItems": 5, "uniqueItems": true },
        "season_ids": { "const": ["2026-2027"] }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["match_id", "provider", "provider_match_id", "league_id", "season_id", "home_score", "away_score", "status", "evidence"],
        "properties": {
          "match_id": { "type": "string", "pattern": "^FT-M-FOOTBALLDATA-[A-Za-z0-9_-]+$" },
          "provider": { "const": "football-data" },
          "provider_match_id": { "type": "string", "minLength": 1 },
          "league_id": { "enum": ["PL", "PD", "BL1", "SA", "FL1"] },
          "season_id": { "const": "2026-2027" },
          "home_team_id": { "type": ["string", "null"] },
          "away_team_id": { "type": ["string", "null"] },
          "home_team_name": { "type": ["string", "null"] },
          "away_team_name": { "type": ["string", "null"] },
          "kickoff_at": { "type": ["string", "null"], "format": "date-time" },
          "home_score": { "type": "integer", "minimum": 0 },
          "away_score": { "type": "integer", "minimum": 0 },
          "status": { "const": "FINISHED" },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["classification", "source_provider", "database_generated_at", "verification_status", "revision_history_available"],
            "properties": {
              "classification": { "const": "legacy_database_snapshot" },
              "source_provider": { "type": "string", "minLength": 1 },
              "database_generated_at": { "type": ["string", "null"], "format": "date-time" },
              "verification_status": { "const": "not_independently_verified" },
              "revision_history_available": { "const": false }
            }
          }
        }
      }
    }
  }
}
